# Copy to .env and fill in.  .env is gitignored; this example file is not.
#   cp .env.example .env

# --- Gemini ----------------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Google Drive ----------------------------------------------------------
# Path to the service account JSON key. Same relative path works locally and
# in the container (compose mounts it to /app/secrets/service-account.json).
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json

# --- Email report ----------------------------------------------------------
SMTP_USER=wgilpin@gmail.com
# 16-character app password from https://myaccount.google.com/apppasswords
# (requires 2FA). Not your normal Google password.
SMTP_APP_PASSWORD=
MAIL_TO=wgilpin@gmail.com

# --- Behaviour -------------------------------------------------------------
TZ=Europe/London
LOG_LEVEL=INFO
